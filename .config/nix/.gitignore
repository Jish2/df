# build input, fetched on demand via scripts/fetch-baseline.sh
baseline/

# discovery report, generated locally by scripts/export-defaults.py —
# browsed, hand-picked into common.nix, then discarded. never imported.
modules/darwin/imported-defaults*.nix

# local pre-migration safety copy, never committed
pre-nix-snapshot/

# nix build symlink in the repo root (make plan / darwin-rebuild outputs)
result

# fleet private facts (e.g. the headscale control-plane instance ID the
# tailnet-join wizard and `make hs-nodes` read). never committed — the
# repo is public.
secrets/
