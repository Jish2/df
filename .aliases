# reload
alias r="source ~/.zshrc && tmux source-file ~/.tmux.conf"

# open config
alias config="nvim ~/.zshrc"

# nodet (node typescript)
alias nodet="npx ts-node"

# gh release pr
alias ghrl="gh pr create --base prod --head main --title release --body \"\""

# apply flake.nix changes
alias flake="(cd ~/.config/nix && make apply)"

# genji worktree
alias gwtc='create_genji_worktree'
alias gwt='git worktree'

alias sqlite='/opt/homebrew/Cellar/sqlite/3.50.1/bin/sqlite3'

alias kubectl='kubecolor'
alias k='kubectl'
alias kd='kubectl --context ssodev'
alias ks='kubectl --context ssostg'
alias kp='kubectl --context ssoprod'

# brewfile
alias brewfile="nvim ~/Brewfile"
alias brewdump='brew bundle dump --file=~/Brewfile --force'
alias brewinstall='brew bundle --file=~/Brewfile --force' # add cleanup flag to remove undeclared apps

# tailscale
alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"

# chatgpt helper
alias gpt='~/github/scripts/query-chat-gpt-through-codex.sh'

# cloudflared tunnel shortcuts
alias t3on='t3code-tunnel on'
alias t3off='t3code-tunnel off'
alias t3restart='t3code-tunnel restart'
alias t3status='t3code-tunnel status'
alias t3logs='t3code-tunnel logs'
