#!/usr/bin/env python3
"""Load common and machine-specific skills from a private checkout."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

REMOTE = 'https://github.rbx.com/jgoon/skills.git'


class SyncError(Exception):
    pass


def command(args, cwd=None):
    try:
        result = subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=45)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise SyncError(f'{args[0]} could not complete: {type(error).__name__}') from error
    if result.returncode:
        # Do not echo authentication-helper output into hook logs.
        raise SyncError(f'{args[0]} failed (exit {result.returncode}); private repository access is required')
    return result.stdout.strip()


def refresh(repo, state, offline):
    if not repo.exists():
        if offline:
            raise SyncError('No private checkout exists; run skills-sync with repository access first')
        repo.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix='clone-', dir=state) as temporary:
            clone = Path(temporary) / 'repo'
            command(['gh', 'repo', 'clone', REMOTE, str(clone), '--', '--branch', 'main'])
            shutil.move(str(clone), str(repo))
        return None
    if not (repo / '.git').exists():
        raise SyncError('The private checkout path already contains a non-Git directory')
    if offline:
        return None
    if command(['git', 'remote', 'get-url', 'origin'], repo).removesuffix('.git') != REMOTE.removesuffix('.git'):
        raise SyncError('The checkout origin differs from the configured private repository')
    if command(['git', 'status', '--porcelain'], repo):
        return 'Local edits were preserved; loading the checkout without pulling'
    if command(['git', 'branch', '--show-current'], repo) != 'main':
        return 'A local feature branch is checked out; loading it without pulling'
    try:
        command(['git', 'pull', '--ff-only', '--no-rebase', 'origin', 'main'], repo)
    except SyncError as error:
        return f'{error}; loading the existing checkout'
    return None


def skills_in(directory, repo):
    if not directory.exists():
        return {}
    if not directory.is_dir():
        raise SyncError(f'Expected a skill directory: {directory}')
    selected = {}
    for child in sorted(directory.iterdir()):
        if child.name.startswith('.') or not child.is_dir() or not (child / 'SKILL.md').is_file():
            continue
        target = child.resolve()
        if not target.is_relative_to(repo.resolve()):
            raise SyncError('A skill folder points outside the private checkout')
        selected[child.name] = str(target)
    return selected


def points_to(path, target):
    return path.is_symlink() and str(path.resolve()) == target


def machine_role(explicit, state):
    if explicit is not None:
        role = explicit
    elif (state / 'machine').exists():
        role = (state / 'machine').read_text().strip()
    else:
        try:
            role = command(['make', '-s', '--no-print-directory', '-C',
                            str(Path.home() / '.config/nix'), 'skills-machine'])
        except SyncError:
            role = 'unknown'
    if Path(role).name != role or role in ('', '.', '..'):
        raise SyncError('The machine role must be a single directory name')
    return role


def link_skills(repo, links, state, machine):
    desired = skills_in(repo / 'common', repo)
    desired.update(skills_in(repo / 'machines' / machine, repo))
    manifest = state / 'links.json'
    previous = json.loads(manifest.read_text()) if manifest.exists() else {}
    if not isinstance(previous, dict):
        raise SyncError('Invalid private skill link manifest')
    owned = previous.get('links', {})
    if not isinstance(owned, dict) or any(
        Path(name).name != name or name in ('', '.', '..') or not isinstance(target, str)
        for name, target in owned.items()
    ):
        raise SyncError('Invalid private skill link manifest')
    for name, target in desired.items():
        link = links / name
        if os.path.lexists(link) and not (
            name in owned and points_to(link, owned[name])
        ):
            raise SyncError(f'Skill {name!r} already exists and is not owned by this loader; left unchanged')
    links.mkdir(parents=True, exist_ok=True)
    for name, target in owned.items():
        if name not in desired and points_to(links / name, target):
            (links / name).unlink()
    for name, target in desired.items():
        link = links / name
        if points_to(link, target):
            continue
        with tempfile.TemporaryDirectory(prefix='.private-skill-', dir=links) as temporary:
            staging = Path(temporary) / 'link'
            staging.symlink_to(target, target_is_directory=True)
            os.replace(staging, link)
    temporary_manifest = state / 'links.json.new'
    temporary_manifest.write_text(json.dumps({'machine': machine, 'links': desired}, indent=2) + '\n')
    temporary_manifest.replace(manifest)
    return len(desired)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--machine', help='Override and remember the fleet role, such as work or devspace')
    parser.add_argument('--repo-dir', type=Path, default=Path.home() / 'private-skills')
    parser.add_argument('--link-dir', type=Path, default=Path.home() / '.agents' / 'skills')
    parser.add_argument('--state-dir', type=Path, default=Path.home() / '.local' / 'state' / 'private-skills')
    parser.add_argument('--offline', action='store_true', help='Load the current checkout without network requests')
    parser.add_argument('--optional', action='store_true', help='Warn instead of failing a dotfiles hook')
    args = parser.parse_args(argv)
    try:
        args.state_dir.mkdir(parents=True, exist_ok=True)
        with (args.state_dir / 'sync.lock').open('a') as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError as error:
                raise SyncError('Another private skill sync is already running') from error
            machine = machine_role(args.machine, args.state_dir)
            warning = refresh(args.repo_dir, args.state_dir, args.offline)
            loaded = link_skills(args.repo_dir, args.link_dir, args.state_dir, machine)
            if args.machine is not None:
                (args.state_dir / 'machine').write_text(machine + '\n')
        if warning:
            print(f'skills-sync: {warning}', file=sys.stderr)
        if machine == 'unknown':
            print('skills-sync: machine role unknown; use --machine ROLE to enable machine-specific skills', file=sys.stderr)
        print(f'skills-sync: loaded {loaded} private skills for {machine}')
        return 0
    except (SyncError, OSError, ValueError) as error:
        print(f'skills-sync: {error}', file=sys.stderr)
        return 0 if args.optional else 1


if __name__ == '__main__':
    sys.exit(main())
